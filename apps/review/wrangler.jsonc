{
  "name": "harrhy-review-local",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "HARRHY_REVIEW_ORIGIN": "http://127.0.0.1:9867",
    "HARRHY_REVIEW_BROWSER_ORIGIN": "",
  },
  "durable_objects": {
    "bindings": [{ "name": "REVIEWS", "class_name": "ReviewCell" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReviewCell"] }],
}
