{
  "name": "harrhy-world-room",
  "main": "celld/worker.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "WORLD_ROOM", "class_name": "WorldRoomCell" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldRoomCell"] }],
  "rules": [{ "type": "Data", "globs": ["**/*.bsp"] }],
}
