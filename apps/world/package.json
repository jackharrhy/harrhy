{
  "name": "@harrhy/world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "test": "bun test __tests__/room.test.ts",
    "build": "vite build && bun build server/index.ts --target=bun --outdir dist/server",
    "start": "bun dist/server/index.js",
    "dev": "npm run build && npm start",
    "test:browser": "node __tests__/browser-smoke.mjs",
    "check": "npm run build:movement && npm run typecheck && npm test && npm run build",
    "build:movement": "npm run build -w @harrhy/worldview-renderer",
    "predev": "npm run build:movement"
  },
  "dependencies": {
    "@harrhy/pool-simulation": "0.1.0",
    "@harrhy/ui": "0.1.0",
    "@harrhy/worldview-renderer": "0.2.0",
    "bitecs": "0.4.0",
    "remix": "3.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/three": "0.187.0",
    "vite": "^8.3.8"
  }
}
