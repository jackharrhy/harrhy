{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ref-discussion-local",
  "main": "worker.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "DirectoryCell" },
      { "name": "CURSORS", "class_name": "CursorRoom" },
      { "name": "BOARDS", "class_name": "BoardCell" },
      { "name": "EXPORTS", "class_name": "ExportCell" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DirectoryCell", "BoardCell"] },
    { "tag": "discussion-only", "new_sqlite_classes": ["CursorRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ExportCell"] },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "discussion-local-media" },
  ],
}
