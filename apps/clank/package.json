{
  "name": "@harrhy/clank",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:owner": "node scripts/build-owner.mjs",
    "dev:owner": "node --watch-path=owner --watch-path=scripts/build-owner.mjs --watch-path=../../packages/ui scripts/build-owner.mjs --serve",
    "start:owner": "node .celld/owner/server.mjs",
    "check": "npm run build && npm run build:owner && node --test __tests__/*.test.ts",
    "check:owner-browser": "node --import ../pi/src/source.ts __tests__/owner-browser.ts",
    "check:fixture": "node __tests__/live-fixture.mjs"
  },
  "dependencies": {
    "@harrhy/board": "workspace:*",
    "@harrhy/ui": "workspace:*",
    "@pierre/words": "0.3.0",
    "capnweb": "0.13.0",
    "remix": "3.2.0",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "playwright": "1.65.0"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
