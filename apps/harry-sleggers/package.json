{
  "name": "@harrhy/harry-sleggers",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "start": "node --import remix/node-tsx server.ts",
    "dev": "node --watch --import remix/node-tsx server.ts",
    "build": "tsrs --noEmit && esbuild app/browser.ts --bundle --format=esm --platform=browser --outfile=dist/runtime.js",
    "check": "npm run build && node --import remix/node-tsx --test __tests__/*.test.ts",
    "test:browser": "node __tests__/browser.mjs"
  },
  "dependencies": {
    "@harrhy/ui": "*",
    "remix": "3.2.0",
    "pg": "8.16.3",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.15.6",
    "playwright": "1.65.0"
  }
}
