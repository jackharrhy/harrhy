{
  "name": "@harrhy/atlas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "node --watch --import remix/node-tsx server.ts",
    "start": "node --import remix/node-tsx server.ts",
    "typecheck": "tsrs --noEmit",
    "test": "node --import remix/node-tsx --test app/content/__tests__/*.test.ts __tests__/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@shikijs/rehype": "4.6.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remix": "3.2.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/node": "26.6.6"
  }
}
