HOST=127.0.0.1
PORT=4351
HARRHY_CMS_DATA_DIR=data
# Optional read-only MCP endpoint at /tea/mcp on each site host.
# HARRHY_CMS_MCP_TOKEN=
# Optional operator dashboard origin (separate from every site origin).
# HARRHY_CMS_OPERATOR_ORIGIN=https://teacms.example.com
# Auth mode requires all browser clients and reviewed issuer+subject links.
# Initial access is pinned to the existing reviewed owner, never an email address.
# HARRHY_AUTH_ISSUER=https://auth.jackharrhy.dev
# HARRHY_AUTH_PROJECT_ID=
# HARRHY_AUTH_ORGANIZATION_ID=
# HARRHY_AUTH_OWNER_SUBJECT=
# HARRHY_AUTH_OPERATOR_CLIENT_ID=
# HARRHY_AUTH_ANDREW_CLIENT_ID=
# HARRHY_AUTH_LUKE_CLIENT_ID=
# HARRHY_AUTH_INTROSPECTION_CLIENT_ID=
# HARRHY_AUTH_INTROSPECTION_SECRET=
# Set these only while running cms:seed-operator; never commit credentials.
# HARRHY_CMS_OPERATOR_EMAIL=
# HARRHY_CMS_OPERATOR_PASSWORD=
# Set these only when running cms:seed-users; never commit credentials.
# HARRHY_CMS_ADMIN_EMAIL=
# HARRHY_CMS_ADMIN_PASSWORD=
