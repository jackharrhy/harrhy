      ],
      "@earendil-works/pi-codemode/cloudflare": [
        "./compat/packages/codemode/src/cloudflare.ts"
      ],
      "@earendil-works/pi-codemode/declarations": [
        "./compat/packages/codemode/src/declarations.ts"
      ],
      "@earendil-works/pi-codemode/portable": [
        "./compat/packages/codemode/src/portable.ts"
      ],
      "@earendil-works/pi-codemode/source": [
        "./compat/packages/codemode/src/source.ts"
      ],
      "@earendil-works/pi-codemode/worker": [
        "./compat/packages/codemode/src/runtime/worker.ts"
      ],
      "@earendil-works/pi-schema": ["./compat/packages/schema/src/index.ts"],
