        "./compat/packages/mcp/src/oauth/index.ts"
      ],
      "@earendil-works/pi-mcp/testing": [
        "./compat/packages/mcp/src/testing/index.ts"
      ],
      "@earendil-works/pi-ai": ["./compat/packages/ai/src/index.ts"],
      "@earendil-works/pi-ai/oauth": ["./compat/packages/ai/src/oauth.ts"],
      "@earendil-works/pi-ai/*": [
        "./compat/packages/ai/src/*.ts",
        "./compat/packages/ai/src/providers/*.ts"
      ],
      "@earendil-works/pi-ai/dist/*": ["./compat/packages/ai/src/*"],
      "@earendil-works/pi-durable": ["./compat/packages/durable/src/index.ts"],
      "@earendil-works/pi-durable/testing": [
        "./compat/packages/durable/src/testing/index.ts"
      ],
      "@earendil-works/pi-durable/*": [
        "./compat/packages/durable/src/*.ts",
        "./compat/packages/durable/src/*/index.ts",
        "./compat/packages/durable/src/*"
      ],
      "@earendil-works/pi-env": ["./compat/packages/env/src/index.ts"],
      "@earendil-works/pi-agent-core": ["./compat/packages/agent/src/index.ts"],
      "@earendil-works/pi-coding-agent": [
        "./compat/packages/coding-agent/src/index.ts"
      ],
      "@earendil-works/pi-coding-agent/hooks": [
        "./compat/packages/coding-agent/src/core/hooks/index.ts"
      ],
      "@earendil-works/pi-coding-agent/*": [
        "./compat/packages/coding-agent/src/*"
      ],
      "typebox": ["./compat/node_modules/typebox"],
      "@earendil-works/pi-tui": ["./compat/packages/tui/src/index.ts"],
      "@earendil-works/pi-tui/*": ["./compat/packages/tui/src/*"],
      "@earendil-works/pi-agent-old": [
        "./compat/packages/agent-old/src/index.ts"
      ],
      "@earendil-works/pi-agent-old/*": ["./compat/packages/agent-old/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "integrations/**/*.ts",
    "__tests__/p2/**/*.ts",
    "scripts/**/*.ts"
  ]
}
